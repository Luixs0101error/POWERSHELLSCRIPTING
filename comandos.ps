# Update the package list from repositories
sudo apt update

# Upgrade all installed packages to their latest versions
sudo apt upgrade

# Install the 'parted' tool (used for disk partition management)
sudo apt install parted

# List all disk partitions using parted (-l = list)
# Then print a separator line
# Then show block devices with filesystem info (lsblk -f)
# Then print a blank line for readability
sudo parted -l && echo -e "\n---\n" && lsblk -f && echo -e

# Show block devices with filesystem details (again, standalone)
lsblk -f

#Check if the directory /sys/firmware/efi exists (this indicates a UEFI system)
[ -d /sys/firmware/efi ] && echo "UEFI" || echo "BIOS"

Create archive
echo "esto es un archivo" > archivo.txt

Start the archive
stat archivo.txt